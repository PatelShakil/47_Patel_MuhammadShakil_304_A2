<form method="POST" action="/admin/login">
    <input type="text" name="username" placeholder="Admin Username" required />
    <input type="password" name="password" placeholder="Password" required />
    <% if(error) { %>
        <p style="color:red;">
            <%= error %>
        </p>
        <% } %>
            <button type="submit">Login</button>
</form>